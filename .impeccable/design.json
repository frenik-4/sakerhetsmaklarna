      "html": "<figure class=\"ds-sp\"><div class=\"ds-sp-h\">Detektorer</div><ul class=\"ds-sp-list\"><li><span class=\"id\">D2</span><span>Bodetablering</span><span class=\"st\"><i></i>I drift</span></li><li class=\"live\"><span class=\"id\">D3</span><span>Ställning norr</span><span class=\"st\"><i></i>Rörelse</span></li></ul><div class=\"ds-sp-h\">Larmcentral</div><ol class=\"ds-sp-log\"><li><time>02:14:31</time><span>Operatör granskar bilderna</span></li><li class=\"beslut\"><time>02:14:52</time><span>Person på ställningen. Väktare skickas.</span></li></ol></figure>",
      "css": ".ds-sp{margin:0;max-width:380px;padding:16px 24px 24px;color:#e8eef6;background:#0c2546;border:1px solid rgba(255,255,255,.14);border-radius:18px;box-shadow:0 2px 4px rgba(7,26,51,.08),0 24px 48px -16px rgba(7,26,51,.28),inset 0 1px 0 rgba(255,255,255,.06);font-family:'Archivo Variable','Archivo',system-ui,sans-serif}.ds-sp-h{margin:0 0 12px;font:600 .75rem/1.3 inherit;text-transform:uppercase;letter-spacing:.1em;color:#a9b8cb}.ds-sp-list{list-style:none;margin:0 0 20px;padding:0;font-size:.9rem}.ds-sp-list li{display:grid;grid-template-columns:2.2em 1fr auto;align-items:center;gap:8px;padding:9px 8px;border-radius:8px}.ds-sp-list .id{color:#a9b8cb;font-size:.8rem;font-variant-numeric:tabular-nums}.ds-sp-list .st{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;color:#a9b8cb}.ds-sp-list i{width:8px;height:8px;border-radius:50%;background:#4fd18b}.ds-sp-list .live{background:rgba(253,221,0,.1);box-shadow:inset 0 0 0 1px rgba(253,221,0,.35)}.ds-sp-list .live .st{color:#fddd00;font-weight:600}.ds-sp-list .live i{background:#fddd00}.ds-sp-log{list-style:none;margin:0;padding:0;position:relative;font-size:.875rem}.ds-sp-log:before{content:'';position:absolute;left:4px;top:8px;bottom:8px;width:1px;background:rgba(255,255,255,.12)}.ds-sp-log li{position:relative;display:grid;gap:2px;padding:0 0 12px 24px}.ds-sp-log li:before{content:'';position:absolute;left:0;top:6px;width:9px;height:9px;border-radius:50%;background:#0c2546;border:1.5px solid #a9b8cb}.ds-sp-log time{font-size:.75rem;color:#a9b8cb;font-variant-numeric:tabular-nums}.ds-sp-log .beslut span{color:#fff;font-weight:600}.ds-sp-log .beslut:before{background:#fddd00;border-color:#fddd00}"
    }
