---
import { getCollection } from 'astro:content';
import { NAV, url } from '../lib/site';
interface Props { exclude?: string; }
const { exclude } = Astro.props;
const tjanster = (await getCollection('tjanster')).filter((t) => t.id !== exclude).sort((a, b) => a.data.order - b.data.order);
---
<ul class:list={['services', { 'services--related': exclude }]} role="list">
  {tjanster.map((t) => {
    const href = `/${t.id}/`;
    const name = NAV.find((item) => item.href === href)?.label ?? t.data.h1;
    return (
      <li class="reveal">
        <a href={url(href)}>
          <h3>{name}</h3>
          <p>{t.data.short}</p>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .services {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none; margin: 0; padding: 0; border-block: 1px solid var(--line);
  }
  .services--related { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  li + li { border-left: 1px solid var(--line); }
  a {
    position: relative; display: block; min-height: 100%; padding: 21px clamp(10px, 1.25vw, 18px) 24px;
    color: var(--ink); text-decoration: none;
  }
  a::after {
    content: ''; position: absolute; inset: 0 0 auto auto;
    width: 26px; height: 26px; background: var(--blue);
    clip-path: polygon(0 0, 100% 0, 100% 100%); opacity: 0;
  }
  a:is(:hover, :focus-visible)::after { opacity: 1; }
  a:is(:hover, :focus-visible) h3 { text-decoration: underline; text-underline-offset: .16em; }
  a:focus-visible { outline-offset: -3px; }
  h3 { margin-bottom: 6px; color: var(--blue); font-size: clamp(1.375rem, 2.1vw, 1.6875rem); overflow-wrap: anywhere; }
  p { margin: 0; font-size: .9375rem; line-height: 1.5; }
  li:nth-child(2) { --reveal-delay: 60ms; }
  li:nth-child(3) { --reveal-delay: 120ms; }
  li:nth-child(4) { --reveal-delay: 180ms; }
  li:nth-child(5) { --reveal-delay: 240ms; }
  @media (max-width: 900px) {
    .services, .services--related { grid-template-columns: minmax(0, 1fr); }
    li:nth-child(n) { --reveal-delay: 0ms; }
    li + li { border-left: 0; border-top: 1px solid var(--line); }
    a { padding-inline: 0 25px; }
    h3 { font-size: 1.6875rem; }
  }
</style>
