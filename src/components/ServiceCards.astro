---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { TJANST_BILD } from '../lib/bilder';
import { url } from '../lib/site';
interface Props { exclude?: string; }
const { exclude } = Astro.props;
const tjanster = (await getCollection('tjanster')).filter((t) => t.id !== exclude).sort((a, b) => a.data.order - b.data.order);
const namn: Record<string, string> = { bygglarm: 'Bygglarm', stallningslarm: 'Ställningslarm', 'butik-kontor': 'Butik & kontor', kamerabevakning: 'Kamerabevakning', larmvaska: 'Larmväska' };
---
<!-- Tjänsteindex: hela raden är klickbar. -->
<ul class="svc">
  {tjanster.map((t) => (
    <li class="svc__row">
      <Image src={TJANST_BILD[t.id].src} alt="" widths={[300, 600]} sizes="(max-width: 700px) 96px, 220px" class="svc__img" />
      <h3 class="svc__name"><a href={url(`/${t.id}/`)} class="svc__link">{namn[t.id] ?? t.data.h1}</a></h3>
      <p class="svc__short">{t.data.short}</p>
      <span class="svc__go" aria-hidden="true"><Icon name="arrow" /></span>
    </li>
  ))}
</ul>

<style>
  .svc { list-style: none; margin: 0; padding: var(--s2); background: var(--plate); border: 1px solid var(--rule); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .svc__row {
    position: relative; display: grid; align-items: center; gap: var(--s5);
    grid-template-columns: 150px minmax(0, 17rem) minmax(0, 1fr) 44px;
    padding: var(--s3); border-radius: 12px;
    transition: background-color .2s var(--ease-out);
  }
  .svc__row + .svc__row::before { content: ''; position: absolute; top: -1px; left: var(--s3); right: var(--s3); height: 1px; background: var(--rule); }
  .svc__row:hover, .svc__row:focus-within { background: var(--blue-50); }
  .svc__row:hover::before, .svc__row:hover + .svc__row::before { opacity: 0; }
  .svc :global(.svc__img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 8px; transition: scale .5s var(--ease-out); }
  .svc__row:hover :global(.svc__img) { scale: 1.03; }
  .svc__name { margin: 0; font-size: clamp(1.25rem, 2vw, 1.5rem); letter-spacing: -.02em; }
  .svc__link { color: var(--ink); text-decoration: none; }
  .svc__link::after { content: ''; position: absolute; inset: 0; border-radius: 12px; }
  .svc__link:focus-visible { outline: none; }
  .svc__row:focus-within { outline: 2px solid var(--blue); outline-offset: -2px; }
  .svc__short { margin: 0; color: var(--muted); }
  .svc__go { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid #c6d0dc; color: var(--ink); transition: background-color .2s, color .2s, border-color .2s; }
  .svc__go :global(svg) { width: 18px; height: 18px; transition: translate .25s var(--ease-out); }
  .svc__row:hover .svc__go, .svc__row:focus-within .svc__go { background: var(--blue); border-color: var(--blue); color: #fff; }
  .svc__row:hover .svc__go :global(svg) { translate: 2px 0; }

  @media (max-width: 900px) {
    .svc__row { grid-template-columns: 96px minmax(0, 1fr) 40px; gap: var(--s1) var(--s4); }
    .svc :global(.svc__img) { grid-row: span 2; aspect-ratio: 1; }
    .svc__name { align-self: end; }
    .svc__short { grid-column: 2; font-size: .95rem; align-self: start; }
    .svc__go { grid-column: 3; grid-row: 1 / span 2; width: 40px; height: 40px; }
  }
  @media (max-width: 600px) {
    .svc { padding: var(--s1); }
    .svc__row { grid-template-columns: 72px minmax(0, 1fr); gap: var(--s1) var(--s3); padding: var(--s3) var(--s2); }
    .svc__go { display: none; }
    .svc__name { font-size: 1.2rem; }
  }
</style>
