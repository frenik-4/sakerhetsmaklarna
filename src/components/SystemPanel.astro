---
// Exempelvy av ett larmobjekt i drift. All data är påhittad och märkt "Exempel".
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import bild from '../assets/img/stallningslarm.jpg';

const detektorer = [
  { id: 'D1', namn: 'Entré, port väst', status: 'I drift' },
  { id: 'D2', namn: 'Bodetablering', status: 'I drift' },
  { id: 'D3', namn: 'Ställning norr', status: 'Rörelse', live: true },
  { id: 'D4', namn: 'Container, verktyg', status: 'I drift' },
  { id: 'D5', namn: 'Kranplats', status: 'I drift' },
];
const logg = [
  { t: '02:14:07', text: 'Larm från D3, ställning norr' },
  { t: '02:14:09', text: 'Tre bilder mottagna' },
  { t: '02:14:31', text: 'Operatör granskar bilderna' },
  { t: '02:14:52', text: 'Person på ställningen. Väktare skickas.', beslut: true },
];
---
<figure class="sp" aria-label="Exempel: så ser ett larmobjekt ut i drift">
  <div class="sp__top">
    <span class="sp__obj"><span class="dot" aria-hidden="true"></span>Byggarbetsplats, Stockholm · larm tillkopplat</span>
    <span class="sp__tag">Exempel</span>
  </div>
  <div class="sp__panes">
    <section class="sp__pane" aria-label="Detektorer">
      <h3 class="sp__h"><Icon name="radio" />Detektorer</h3>
      <ul class="sp__list">
        {detektorer.map((d) => (
          <li class:list={{ 'is-live': d.live }}>
            <span class="sp__id num">{d.id}</span>
            <span class="sp__name">{d.namn}</span>
            <span class="sp__st"><span class:list={['dot', { 'dot--live': d.live }]} aria-hidden="true"></span>{d.status}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="sp__pane sp__pane--img" aria-label="Händelse med bildverifiering">
      <h3 class="sp__h"><Icon name="image" />Händelse <span class="num">02:14</span></h3>
      <div class="sp__shot">
        <Image src={bild} alt="" widths={[480, 760]} sizes="(max-width: 900px) 90vw, 420px" loading="eager" />
        <span class="sp__box" aria-hidden="true"></span>
        <span class="sp__ov sp__ov--tl">D3 · Ställning norr</span>
        <span class="sp__ov sp__ov--br num">02:14:07 · Bild 1/3</span>
      </div>
      <p class="sp__cap">Detektorn har kamera. Bilderna går direkt till larmcentralen.</p>
    </section>
    <section class="sp__pane" aria-label="Larmcentralens logg">
      <h3 class="sp__h"><Icon name="headset" />Larmcentral</h3>
      <ol class="sp__log">
        {logg.map((l, i) => (
          <li class:list={{ 'is-beslut': l.beslut }} style={`--i:${i}`}>
            <time class="num">{l.t}</time><span>{l.text}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</figure>

<style>
  .sp {
    margin: 0; color: var(--on-navy); background: var(--navy-800);
    border: 1px solid rgba(255, 255, 255, .14); border-radius: 18px; box-shadow: var(--shadow-lg), inset 0 1px 0 rgba(255, 255, 255, .06);
    overflow: hidden;
  }
  .sp__top { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); padding: var(--s3) var(--s5); border-bottom: 1px solid var(--line-dark); font-size: .875rem; }
  .sp__obj { display: inline-flex; align-items: center; gap: var(--s2); color: var(--on-navy); }
  .sp__obj .dot { background: var(--ok-on-dark); }
  .sp__tag { font: 600 .7rem/1 var(--font); text-transform: uppercase; letter-spacing: .1em; color: var(--navy); background: var(--on-navy); padding: 5px 8px; border-radius: 999px; }
  .sp__panes { display: grid; grid-template-columns: 1fr 1.25fr 1.1fr; }
  .sp__pane { padding: var(--s4) var(--s5) var(--s5); min-width: 0; }
  .sp__pane + .sp__pane { border-left: 1px solid var(--line-dark); }
  .sp__h { display: flex; align-items: center; gap: var(--s2); margin: 0 0 var(--s3); font: 600 .75rem/1.3 var(--font); text-transform: uppercase; letter-spacing: .1em; color: var(--on-navy-muted); }
  .sp__h :global(svg) { width: 15px; height: 15px; }
  .sp__h .num { color: var(--on-navy); }

  .sp__list { list-style: none; margin: 0; padding: 0; font-size: .9rem; }
  .sp__list li { display: grid; grid-template-columns: 2.2em 1fr auto; align-items: center; gap: var(--s2); padding: 9px var(--s2); border-radius: 8px; }
  .sp__list li + li { margin-top: 2px; }
  .sp__id { color: var(--on-navy-muted); font-size: .8rem; }
  .sp__name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp__st { display: inline-flex; align-items: center; gap: 6px; font-size: .8rem; color: var(--on-navy-muted); }
  .sp__st .dot { background: var(--ok-on-dark); }
  .sp__list .is-live { background: rgba(253, 221, 0, .1); box-shadow: inset 0 0 0 1px rgba(253, 221, 0, .35); }
  .sp__list .is-live .sp__st { color: var(--yellow); font-weight: 600; }
  .sp__list .is-live .sp__st .dot { background: var(--yellow); }

  .sp__shot { position: relative; aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; background: #020a14; }
  .sp__shot :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15) brightness(.8); animation: bild .9s var(--ease-out) .5s both; }
  .sp__box { position: absolute; left: 54%; top: 22%; width: 18%; height: 34%; border: 1.5px solid var(--yellow); border-radius: 3px; animation: ram .5s var(--ease-out) 1.2s both; }
  .sp__ov { position: absolute; font: 600 .72rem/1 var(--font); color: #fff; background: rgba(2, 10, 20, .72); padding: 5px 7px; border-radius: 5px; }
  .sp__ov--tl { top: 8px; left: 8px; }
  .sp__ov--br { right: 8px; bottom: 8px; }
  .sp__cap { margin: var(--s3) 0 0; font-size: .85rem; color: var(--on-navy-muted); }

  .sp__log { list-style: none; margin: 0; padding: 0; position: relative; font-size: .875rem; }
  .sp__log::before { content: ''; position: absolute; left: 4px; top: 8px; bottom: 8px; width: 1px; background: var(--line-dark); }
  .sp__log li { position: relative; display: grid; gap: 2px; padding: 0 0 var(--s3) var(--s5); animation: rad .5s var(--ease-out) both; animation-delay: calc(.9s + var(--i) * .45s); }
  .sp__log li::before { content: ''; position: absolute; left: 0; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--navy-800); border: 1.5px solid var(--on-navy-muted); }
  .sp__log time { font-size: .75rem; color: var(--on-navy-muted); }
  .sp__log .is-beslut span { color: #fff; font-weight: 600; }
  .sp__log .is-beslut::before { background: var(--yellow); border-color: var(--yellow); }

  @keyframes bild { from { opacity: 0; filter: grayscale(1) blur(6px) brightness(.6); } }
  @keyframes ram { from { opacity: 0; scale: 1.3; } }
  @keyframes rad { from { opacity: 0; translate: 0 6px; } }

  @media (max-width: 1000px) {
    .sp__panes { grid-template-columns: 1fr 1fr; }
    .sp__pane--img { grid-column: 1 / -1; grid-row: 1; border-bottom: 1px solid var(--line-dark); }
    .sp__pane--img + .sp__pane { border-left: 0; }
  }
  @media (max-width: 640px) {
    .sp__top { padding: var(--s3) var(--s4); }
    .sp__obj { font-size: .8rem; }
    .sp__panes { grid-template-columns: 1fr; }
    .sp__pane { padding: var(--s4); }
    .sp__pane + .sp__pane, .sp__pane--img + .sp__pane { border-left: 0; border-top: 1px solid var(--line-dark); }
    .sp__pane--img { border-bottom: 0; grid-row: auto; }
    .sp__list li:nth-child(n+4):not(.is-live), .sp__list li:first-child { display: none; }
    .sp__shot { aspect-ratio: 16 / 9; }
  }
</style>
