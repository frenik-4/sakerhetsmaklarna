---
import Icon from './Icon.astro';
import { SITE, url } from '../lib/site';
interface Props { rubrik?: string; text?: string; }
const { rubrik = 'Behöver du larm redan i dag?', text = 'Ring oss så berättar vi vad som går att ordna. I de flesta fall är larmet i drift samma dag som beställningen.' } = Astro.props;
---
<section class="cta section--dark">
  <div class="wrap cta__in">
    <div class="cta__copy">
      <h2>{rubrik}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__call">
      <span class="field__k">Ring oss</span>
      <a class="cta__tel num" href={SITE.telefonHref}>{SITE.telefon}</a>
      <a class="btn btn--primary" href={url('/kontakt/')}>Begär offert <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .cta { padding: var(--s9) 0; color: var(--on-navy); }
  .cta h2 { color: #fff; }
  .cta p { max-width: 48ch; margin: 0; font-size: 1.125rem; color: var(--on-navy-muted); }
  .cta__in { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s6); align-items: center; }
  .cta__call { background: rgba(12, 37, 70, .85); border: 1px solid rgba(255, 255, 255, .14); border-radius: var(--radius-lg); padding: var(--s5) var(--s6) var(--s6); display: grid; justify-items: start; gap: var(--s2); box-shadow: var(--shadow-lg); }
  .cta__call .field__k { color: var(--on-navy-muted); margin: 0; }
  .cta__tel { color: #fff; text-decoration: none; font: 700 clamp(2.2rem, 4.4vw, 3.2rem)/1.05 var(--font); letter-spacing: -.03em; margin-bottom: var(--s3); }
  .cta__tel:hover { color: #fff; text-decoration: underline; text-decoration-thickness: 2px; }
  @media (max-width: 860px) { .cta__in { grid-template-columns: 1fr; } .cta__call { padding: var(--s5); } .cta__call .btn { width: 100%; } }
</style>
