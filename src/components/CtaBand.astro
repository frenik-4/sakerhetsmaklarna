---
import Icon from './Icon.astro';
import { SITE, url } from '../lib/site';
interface Props { rubrik?: string; text?: string; }
const { rubrik = 'Behöver du larm redan i dag?', text = 'Ring oss så berättar vi vad som går att ordna. I de flesta fall är larmet i drift samma dag som beställningen.' } = Astro.props;
---
<section class="cta blue-field" data-reveal>
  <div class="wrap cta__in">
    <div class="reveal">
      <h2>{rubrik}</h2>
      <p>{text}</p>
    </div>
    <div class="actions reveal">
      <a class="btn btn--primary" href={SITE.telefonHref}><Icon name="phone" />Ring {SITE.telefon}</a>
      <a class="text-link" href={url('/kontakt/')}>Begär offert <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; isolation: isolate; overflow: clip; padding-block: var(--section-space); }
  .cta::before {
    content: ''; position: absolute; z-index: -1; inset: 0 -25% 0 72%;
    background: var(--blue-dark); transform: skewX(var(--diagonal)); transform-origin: left bottom;
  }
  .cta__in { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px 40px; }
  .cta p { max-width: 55ch; margin: 0; font-size: 1.0625rem; }
</style>
