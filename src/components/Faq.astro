---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string; todo?: string }[]; rubrik?: string; }
const { items, rubrik = 'Vanliga frågor' } = Astro.props;
// Dölj frågor där svaret är ett TODO eller bygger på ett antagande som Tobbe inte bekräftat
const synliga = items.filter((i) => !/TODO/i.test(i.a) && !(i.todo && /antag/i.test(i.todo)));
const schema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: synliga.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
{synliga.length > 0 && (
  <section class="faq" aria-labelledby="faq-rubrik">
    <h2 id="faq-rubrik">{rubrik}</h2>
    {synliga.map((i) => (
      <details>
        <summary>{i.q}<span class="faq__ic" aria-hidden="true"><span class="faq__plus"><Icon name="plus" /></span><span class="faq__minus"><Icon name="minus" /></span></span></summary>
        <p>{i.a}</p>
      </details>
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}

<style>
  .faq { max-width: 76ch; }
  .faq h2 { margin-bottom: var(--s5); }
  details { border-bottom: 1px solid var(--rule); }
  details:first-of-type { border-top: 2px solid var(--ink); }
  summary {
    cursor: pointer; list-style: none; padding: var(--s4) var(--s8) var(--s4) 0; position: relative;
    font: 700 1.15rem/1.35 var(--font); font-stretch: 92%; color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  .faq__ic {
    position: absolute; right: 0; top: 50%; translate: 0 -50%;
    width: 36px; height: 36px; display: grid; place-items: center;
    border: 2px solid var(--ink); color: var(--ink); transition: background-color .15s;
  }
  .faq__ic :global(svg) { width: 20px; height: 20px; display: block; }
  .faq__minus { display: none; }
  summary:hover .faq__ic { background: var(--yellow); }
  details[open] .faq__ic { background: var(--ink); color: var(--yellow); }
  details[open] .faq__plus { display: none; }
  details[open] .faq__minus { display: block; }
  details p { padding-bottom: var(--s5); max-width: 68ch; }
</style>
