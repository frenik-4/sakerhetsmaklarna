---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string; todo?: string }[]; rubrik?: string; limit?: number; }
const { items, rubrik = 'Vanliga frågor', limit } = Astro.props;
// Dölj frågor där svaret är ett TODO eller bygger på ett antagande som Tobbe inte bekräftat
const synliga = items.filter((i) => !/TODO/i.test(i.a) && !(i.todo && /antag/i.test(i.todo))).slice(0, limit);
const schema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: synliga.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
{synliga.length > 0 && (
  <section class="faq" aria-labelledby="faq-rubrik">
    <h2 id="faq-rubrik">{rubrik}</h2>
    {synliga.map((i) => (
      <details>
        <summary>{i.q}<span class="faq__ic" aria-hidden="true"><span class="faq__plus"><Icon name="plus" /></span><span class="faq__minus"><Icon name="minus" /></span></span></summary>
        <p>{i.a}</p>
      </details>
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}

<style>
  .faq { max-width: 76ch; }
  details { border-bottom: 1px solid var(--line); }
  details:first-of-type { border-top: 1px solid var(--line); }
  summary {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center;
    padding-block: 14px; cursor: pointer; list-style: none; font-weight: 700;
  }
  summary:hover, details[open] summary { color: var(--blue); }
  summary::-webkit-details-marker { display: none; }
  .faq__ic {
    display: grid; place-items: center; width: 34px; height: 34px;
    border: 1px solid var(--blue); border-radius: var(--radius); color: var(--blue);
  }
  .faq__ic :global(svg) { display: block; width: 16px; height: 16px; }
  .faq__minus, details[open] .faq__plus { display: none; }
  details[open] .faq__minus { display: block; }
  details[open] .faq__ic { background: var(--blue); color: var(--white); }
  details p { max-width: 68ch; margin: 0 0 20px; }
</style>
