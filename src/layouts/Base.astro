---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from '../components/Icon.astro';
import { SITE, NAV, url } from '../lib/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.juridisktNamn,
  alternateName: SITE.namn,
  url: new URL(url('/'), Astro.site).href,
  telephone: '+46-8-752-98-00',
  email: SITE.epost,
  foundingDate: String(SITE.grundat),
  address: { '@type': 'PostalAddress', streetAddress: SITE.gata, postalCode: SITE.postnr, addressLocality: SITE.ort, addressCountry: 'SE' },
  areaServed: 'Stockholm',
  description: 'Larmuthyrning för tillfälliga och akuta behov: bygglarm, ställningslarm, kamerabevakning och larmväskor.',
};
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {!SITE.indexera && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="sv_SE" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href={url('/favicon.png')} type="image/png" />
  <meta name="theme-color" content="#005cb9" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#innehall">Hoppa till innehållet</a>

  <header class="hdr">
    <div class="wrap hdr__in">
      <a href={url('/')} class="hdr__logo" aria-label="Säkerhetsmäklarna – startsida">
        <Image src={logo} alt="" width={96} height={77} loading="eager" />
      </a>
      <nav class="hdr__nav" aria-label="Huvudmeny">
        <ul>
          {NAV.map((n) => (
            <li><a href={url(n.href)} aria-current={path === url(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="hdr__cta">
        <a class="hdr__login" href={url('/kameror/')} aria-label="Logga in – Mina kameror" aria-current={path === url('/kameror/') ? 'page' : undefined}><Icon name="lock" /><span>Logga in</span></a>
        <a class="hdr__phone num" href={SITE.telefonHref}><Icon name="phone" /><span>{SITE.telefon}</span></a>
        <a class="btn btn--primary hdr__offert" href={url('/kontakt/')}>Begär offert</a>
      </div>
      <button class="hdr__menu" type="button" aria-label="Meny" aria-expanded="false" aria-controls="mobilmeny">
        <Icon name="menu" />
      </button>
    </div>
    <div id="mobilmeny" class="mnav" hidden>
      <ul class="wrap">
        {NAV.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        <li><a href={url('/om-oss/')}>Om oss</a></li>
        <li><a href={url('/fragor-och-svar/')}>Frågor och svar</a></li>
        <li><a href={url('/kontakt/')}>Kontakt och offert</a></li>
        <li><a href={url('/kameror/')}>Mina kameror (logga in)</a></li>
      </ul>
    </div>
  </header>

  <main id="innehall">
    <slot />
  </main>

  <footer class="ftr section--dark">
    <div class="wrap">
      <div class="ftr__grid">
        <div class="ftr__id">
          <span class="ftr__plate"><Image src={logo} alt="Säkerhetsmäklarna" width={220} height={176} class="ftr__logo" loading="eager" /></span>
          <p class="ftr__tag">Larmuthyrning för tillfälliga och akuta behov sedan {SITE.grundat}.</p>
          <a class="ftr__tel num" href={SITE.telefonHref}>{SITE.telefon}</a>
          <p><a href={`mailto:${SITE.epost}`}>{SITE.epost}</a><br />{SITE.gata}, {SITE.postnr} {SITE.ort}</p>
        </div>
        <div>
          <h2 class="ftr__k">Tjänster</h2>
          <ul class="ftr__links">
            {NAV.slice(0, 5).map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="ftr__k">Företaget</h2>
          <ul class="ftr__links">
            <li><a href={url('/referenser/')}>Referenser</a></li>
            <li><a href={url('/om-oss/')}>Om oss</a></li>
            <li><a href={url('/fragor-och-svar/')}>Frågor och svar</a></li>
            <li><a href={url('/kontakt/')}>Kontakt</a></li>
            <li><a href={url('/integritetspolicy/')}>Integritetspolicy</a></li>
          </ul>
        </div>
        <div>
          <h2 class="ftr__k">Kunder</h2>
          <ul class="ftr__links">
            <li><a href={url('/kameror/')}>Mina kameror</a></li>
            <li><a href={url('/kontakt/')}>Begär offert</a></li>
          </ul>
        </div>
      </div>
      <div class="ftr__legal">© {new Date().getFullYear()} {SITE.juridisktNamn}. Vi använder inga spårningskakor.</div>
    </div>
  </footer>

  <!-- Mobil: alltid nåbar ring-knapp -->
  <div class="callbar">
    <a class="btn btn--primary" href={SITE.telefonHref}><Icon name="phone" />Ring {SITE.telefon}</a>
    <a class="btn btn--ghost" href={url('/kontakt/')}>Offert</a>
  </div>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.hdr__menu');
    const menu = document.getElementById('mobilmeny');
    btn?.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      if (menu) menu.hidden = open;
    });
    // Mjuk ingång för sektioner märkta .reveal
    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -10% 0px' });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-in'));
    }
  </script>
</body>
</html>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, .92); backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--rule); }
  .hdr__in { display: flex; align-items: center; gap: var(--s5); min-height: 72px; }
  .hdr__logo { flex: none; }
  .hdr__logo img { width: 64px; height: auto; }
  .hdr__nav { flex: 1; min-width: 0; }
  .hdr__nav ul { display: flex; list-style: none; margin: 0; padding: 0; gap: 2px; }
  .hdr__nav a {
    display: block; padding: var(--s2) var(--s3); border-radius: 8px; color: var(--text); text-decoration: none; white-space: nowrap;
    font: 550 .95rem/1.2 var(--font); transition: background-color .15s, color .15s;
  }
  .hdr__nav a:hover { background: var(--bg-soft); color: var(--ink); }
  .hdr__nav a[aria-current='page'] { color: var(--blue); background: var(--blue-50); }
  .hdr__cta { flex: none; display: flex; align-items: center; gap: var(--s4); }
  .hdr__login, .hdr__phone { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; text-decoration: none; white-space: nowrap; font: 600 .95rem/1 var(--font); color: var(--text); }
  .hdr__phone { color: var(--ink); font-weight: 650; }
  .hdr__login:hover, .hdr__phone:hover, .hdr__login[aria-current='page'] { color: var(--blue); }
  .hdr__login :global(svg), .hdr__phone :global(svg) { width: 17px; height: 17px; }
  .hdr__offert { min-height: 42px; padding: 0 var(--s4); font-size: .95rem; box-shadow: none; }
  .hdr__menu { display: none; flex: none; width: 48px; height: 48px; border: 0; border-radius: 8px; background: none; color: var(--ink); cursor: pointer; }
  .hdr__menu :global(svg) { width: 26px; height: 26px; }
  .mnav { border-top: 1px solid var(--rule); background: #fff; }
  .mnav ul { list-style: none; margin: 0; padding-top: var(--s2); padding-bottom: var(--s5); }
  .mnav a { display: block; padding: var(--s4) 0; font: 600 1.15rem/1.2 var(--font); color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }

  @media (max-width: 1220px) {
    .hdr__nav { display: none; }
    .hdr__cta { margin-left: auto; }
    .hdr__menu { display: grid; place-items: center; }
  }
  @media (max-width: 640px) {
    .hdr__in { gap: var(--s3); min-height: 64px; }
    .hdr__logo img { width: 54px; }
    .hdr__login span, .hdr__phone, .hdr__offert { display: none; }
  }

  .ftr { color: var(--on-navy-muted); padding: var(--s8) 0 var(--s9); border-top: 1px solid var(--line-dark); }
  .ftr a { color: var(--on-navy); text-decoration: none; }
  .ftr a:hover { color: #fff; text-decoration: underline; }
  .ftr__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: var(--s6); }
  .ftr__plate { display: inline-block; background: #fff; padding: var(--s2) var(--s3); border-radius: var(--radius); margin-bottom: var(--s4); }
  .ftr__logo { width: 96px; }
  .ftr__tag { max-width: 32ch; }
  .ftr__tel { display: block; font: 700 1.75rem/1.1 var(--font); letter-spacing: -.02em; color: #fff !important; margin-bottom: var(--s2); }
  .ftr__k { font: 600 .75rem/1.3 var(--font); text-transform: uppercase; letter-spacing: .1em; color: var(--on-navy-muted); margin-bottom: var(--s4); }
  .ftr__links { list-style: none; margin: 0; padding: 0; }
  .ftr__links li { margin-bottom: var(--s3); }
  .ftr__legal { margin-top: var(--s7); padding-top: var(--s5); border-top: 1px solid var(--line-dark); font-size: .9rem; }
  @media (max-width: 900px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__id { grid-column: 1 / -1; } }

  .callbar { display: none; }
  @media (max-width: 768px) {
    .callbar {
      display: flex; gap: var(--s2); position: fixed; inset: auto 0 0 0; z-index: 60;
      padding: var(--s2) var(--s3) calc(var(--s2) + env(safe-area-inset-bottom));
      background: rgba(7, 26, 51, .94); backdrop-filter: blur(10px); border-top: 1px solid var(--line-dark);
    }
    .callbar .btn:first-child { flex: 1; }
  }
</style>
