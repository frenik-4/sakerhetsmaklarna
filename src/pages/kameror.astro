---
// DEMO: mock-inloggning till kameraportalen. Ingen riktig autentisering, ingen data skickas.
// Riktig version kopplas mot Milestone XProtect (se TobbeCam/server.mjs + mockup/live.js).
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
import bygg from '../assets/img/bygglarm.jpg';
import stallning from '../assets/img/stallningslarm.jpg';
import skylt from '../assets/img/stallning-skylt.jpg';
import montor from '../assets/img/montor-detektor.jpg';
import bil from '../assets/img/skapbil-natur.jpg';

const bild = async (src: ImageMetadata) => (await getImage({ src, width: 800, format: 'webp' })).src;
const kameror = [
  { namn: 'Entré – Port väst', zon: 'Entré', online: true, img: await bild(bil) },
  { namn: 'Gård – Kranplats', zon: 'Gård', online: true, rorelse: true, img: await bild(bygg) },
  { namn: 'Fasad – Ställning norr', zon: 'Ställning', online: true, img: await bild(stallning) },
  { namn: 'Fasad – Ställning syd', zon: 'Ställning', online: true, img: await bild(skylt) },
  { namn: 'Bod – Förråd', zon: 'Gård', online: true, img: await bild(montor) },
  { namn: 'Container – Verktyg', zon: 'Gård', online: false, img: '' },
];
const zoner = [...new Set(kameror.map((k) => k.zon))];
---
<Base title="Kameraportal – logga in | Säkerhetsmäklarna" description="Logga in för att se dina kameror live och bläddra bland inspelningar.">
  <meta slot="head" name="robots" content="noindex" />

  <!-- ============ INLOGGNING ============ -->
  <section id="kp-login" class="section kp-login">
    <div class="wrap kp-login__in">
      <div class="kp-login__intro">
        <h1>Kameraportal</h1>
        <p class="lead">Se dina kameror live och bläddra bland inspelningar, i mobilen eller på datorn.</p>
        <ul class="kp-points">
          <li><Icon name="camera" />Livebild från alla kameror på objektet</li>
          <li><Icon name="clock" />Spola tillbaka och se vad som hände</li>
          <li><Icon name="shield" />Samma kameror som larmcentralen ser</li>
        </ul>
      </div>
      <form id="kp-form" class="kp-card" novalidate>
        <h2>Logga in</h2>
        <p class="kp-demo"><strong>Demo:</strong> skriv vad som helst, inga riktiga kameror är anslutna.</p>
        <label for="kp-user">Användarnamn</label>
        <input id="kp-user" name="user" type="text" autocomplete="username" spellcheck="false" required />
        <label for="kp-pass">Lösenord</label>
        <input id="kp-pass" name="pass" type="password" autocomplete="current-password" required />
        <p class="kp-error" role="alert"></p>
        <button class="btn btn--primary kp-submit" type="submit"><Icon name="lock" />Logga in</button>
        <p class="kp-help">Har du inget konto eller glömt lösenordet? Ring <a href={SITE.telefonHref}>{SITE.telefon}</a>.</p>
      </form>
    </div>
  </section>

  <!-- ============ PORTAL (visas efter inloggning) ============ -->
  <section id="kp-app" class="section kp-app" hidden>
    <div class="wrap">
      <div class="kp-top">
        <div>
          <h1 class="kp-title" tabindex="-1">Mina kameror</h1>
          <p class="kp-site">Byggplats Kv. Hammaren · demo</p>
        </div>
        <button type="button" class="btn btn--secondary" id="kp-logout">Logga ut</button>
      </div>

      <dl class="kp-stats">
        <div><dt>Kameror online</dt><dd>{kameror.filter((k) => k.online).length}</dd></div>
        <div><dt>Offline</dt><dd class="is-bad">{kameror.filter((k) => !k.online).length}</dd></div>
        <div><dt>Händelser senaste dygnet</dt><dd>1</dd></div>
        <div><dt>Larm</dt><dd class="is-ok">Tillkopplat</dd></div>
      </dl>

      <div class="kp-layout">
        <div>
          <div class="kp-filter" role="group" aria-label="Visa kameror">
            <button type="button" aria-pressed="true" data-zon="alla">Alla</button>
            {zoner.map((z) => <button type="button" aria-pressed="false" data-zon={z}>{z}</button>)}
          </div>
          <ul class="kp-grid">
            {kameror.map((k, i) => (
              <li data-zon={k.zon}>
                <button type="button" class="kp-cam" data-i={i} aria-label={`Öppna ${k.namn}`}>
                  <span class="kp-feed">
                    {k.online ? <img src={k.img} alt="" loading="lazy" width="800" height="450" /> : <span class="kp-nosignal">Ingen signal</span>}
                    <span class={`kp-badge ${k.online ? 'is-live' : 'is-off'}`}><span class="kp-dot"></span>{k.online ? 'LIVE' : 'OFFLINE'}{k.rorelse && ' · RÖRELSE'}</span>
                    {k.online && <span class="kp-ts" data-ts></span>}
                  </span>
                  <span class="kp-info"><strong>{k.namn}</strong><span>{k.zon} · {k.online ? 'Spelar in' : 'Kontrollera strömmen'}</span></span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <aside class="kp-events" aria-labelledby="kp-ev">
          <h2 id="kp-ev">Senaste händelser</h2>
          <ol>
            <li class="is-warn"><strong>Rörelse upptäckt</strong>Gård – Kranplats<span>I dag 02:14</span></li>
            <li><strong>Larm tillkopplat</strong>Hela objektet<span>I går 18:02</span></li>
            <li class="is-bad"><strong>Kamera offline</strong>Container – Verktyg<span>I går 11:47</span></li>
            <li><strong>Larm frånkopplat</strong>Hela objektet<span>I går 06:55</span></li>
          </ol>
          <div class="kp-help-box">
            <p>Något som inte stämmer? Vi flyttar, kompletterar eller servar kameran.</p>
            <a class="btn btn--primary" href={SITE.telefonHref}><Icon name="phone" />Ring {SITE.telefon}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <dialog id="kp-viewer" class="kp-viewer" aria-labelledby="kp-vt">
    <div class="kp-vh">
      <h2 id="kp-vt"></h2>
      <button type="button" class="kp-close" aria-label="Stäng"><Icon name="close" /></button>
    </div>
    <div class="kp-big"></div>
    <div class="kp-ctl">
      <button type="button" class="btn btn--primary">● Live</button>
      <button type="button" class="kp-ghost">−10 s</button>
      <button type="button" class="kp-ghost">Paus</button>
      <button type="button" class="kp-ghost">+10 s</button>
      <button type="button" class="kp-ghost">Spara bild</button>
    </div>
    <div class="kp-timeline" aria-label="Tidslinje senaste dygnet, orange markerar rörelse">
      <span class="kp-rec"></span><span class="kp-mv" style="left:22%"></span><span class="kp-mv" style="left:61%"></span><span class="kp-now"></span>
    </div>
    <div class="kp-tl-lab" aria-hidden="true"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>Nu</span></div>
  </dialog>

  <script define:vars={{ kameror }}>
    const $ = (s) => document.querySelector(s);
    const login = $('#kp-login'), app = $('#kp-app'), form = $('#kp-form'), err = form.querySelector('.kp-error');
    const tick = () => document.querySelectorAll('[data-ts]').forEach((e) => (e.textContent = new Date().toLocaleTimeString('sv-SE')));
    setInterval(tick, 1000);

    const visa = (inloggad) => {
      login.hidden = inloggad; app.hidden = !inloggad;
      if (inloggad) { tick(); app.querySelector('.kp-title').focus(); } else { form.reset(); $('#kp-user').focus(); }
      try { sessionStorage.setItem('kp-demo', inloggad ? '1' : ''); } catch {}
    };
    try { if (sessionStorage.getItem('kp-demo') === '1') visa(true); } catch {}

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const tomma = [...form.querySelectorAll('[required]')].filter((f) => !f.value.trim());
      form.querySelectorAll('input').forEach((f) => f.toggleAttribute('aria-invalid', tomma.includes(f)));
      if (tomma.length) { err.textContent = 'Fyll i användarnamn och lösenord.'; tomma[0].focus(); return; }
      err.textContent = '';
      visa(true);
    });
    $('#kp-logout').addEventListener('click', () => visa(false));

    document.querySelectorAll('.kp-filter button').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.kp-filter button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll('.kp-grid li').forEach((li) => (li.hidden = b.dataset.zon !== 'alla' && li.dataset.zon !== b.dataset.zon));
    }));

    const dlg = $('#kp-viewer');
    document.querySelectorAll('.kp-cam').forEach((b) => b.addEventListener('click', () => {
      const k = kameror[b.dataset.i];
      $('#kp-vt').textContent = k.namn;
      $('.kp-big').innerHTML = k.online
        ? `<img src="${k.img}" alt="Livebild från ${k.namn} (demobild)"><span class="kp-badge is-live"><span class="kp-dot"></span>LIVE</span><span class="kp-ts" data-ts></span>`
        : '<span class="kp-nosignal">Ingen signal. Ring oss så felsöker vi kameran.</span>';
      dlg.showModal(); tick();
    }));
    dlg.querySelector('.kp-close').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  </script>
</Base>

<style>
  /* Inloggning */
  .kp-login { background: var(--bg-soft); }
  .kp-login__in { display: grid; grid-template-columns: 1fr 440px; gap: var(--s8); align-items: center; }
  .kp-points { list-style: none; padding: 0; margin: var(--s5) 0 0; display: grid; gap: var(--s3); }
  .kp-points li { display: flex; gap: var(--s3); align-items: center; font-weight: 600; color: var(--ink); }
  .kp-points :global(svg) { width: 22px; height: 22px; color: var(--blue); flex: none; }
  .kp-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: var(--s6); box-shadow: var(--shadow); display: grid; gap: var(--s2); }
  .kp-card h2 { font-size: 1.75rem; margin-bottom: 0; }
  .kp-demo { background: #fff8cc; border-radius: 6px; padding: var(--s2) var(--s3); font-size: .9rem; margin: 0 0 var(--s3); }
  .kp-card label { font-weight: 600; color: var(--ink); font-size: .95rem; margin-top: var(--s2); }
  .kp-card input { font: inherit; font-size: 1rem; min-height: 48px; padding: var(--s3); border: 1px solid #b9c2cd; border-radius: var(--radius); }
  .kp-card input:focus { outline: 3px solid rgba(0, 92, 185, .25); border-color: var(--blue); }
  .kp-card input[aria-invalid] { border-color: var(--error); }
  .kp-error { color: var(--error); font-weight: 600; min-height: 1.4em; margin: 0; }
  .kp-submit { width: 100%; }
  .kp-help { font-size: .9rem; color: var(--muted); margin: var(--s2) 0 0; }
  @media (max-width: 900px) { .kp-login__in { grid-template-columns: 1fr; gap: var(--s6); } .kp-card { padding: var(--s5); } }

  /* Portal */
  .kp-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--s4); flex-wrap: wrap; margin-bottom: var(--s5); }
  .kp-title { margin-bottom: var(--s1); }
  .kp-title:focus { outline: none; }
  .kp-site { color: var(--muted); margin: 0; }
  .kp-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s4); margin: 0 0 var(--s6); }
  .kp-stats div { border: 1px solid var(--line); border-radius: var(--radius); padding: var(--s4); }
  .kp-stats dt { font-size: .9rem; color: var(--muted); }
  .kp-stats dd { margin: 0; font: 400 1.75rem/1.2 var(--font-head); color: var(--ink); }
  .kp-stats .is-bad { color: var(--error); } .kp-stats .is-ok { color: var(--ok); }
  @media (max-width: 700px) { .kp-stats { grid-template-columns: 1fr 1fr; } }

  .kp-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: var(--s6); align-items: start; }
  @media (max-width: 1000px) { .kp-layout { grid-template-columns: 1fr; } }
  .kp-filter { display: flex; gap: var(--s2); flex-wrap: wrap; margin-bottom: var(--s4); }
  .kp-filter button { min-height: 44px; padding: 0 var(--s4); border-radius: 999px; border: 1px solid var(--line); background: #fff; font: 600 .95rem var(--font-body); color: var(--ink); cursor: pointer; }
  .kp-filter button[aria-pressed='true'] { background: var(--blue); border-color: var(--blue); color: #fff; }

  .kp-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .kp-cam { display: block; width: 100%; padding: 0; text-align: left; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; cursor: pointer; font: inherit; color: inherit; }
  .kp-cam:hover { border-color: var(--blue); }
  .kp-feed, .kp-big { position: relative; display: block; aspect-ratio: 16 / 9; background: #10151c; overflow: hidden; }
  .kp-feed img, .kp-big img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85); }
  .kp-nosignal { position: absolute; inset: 0; display: grid; place-items: center; color: #c5ccd6; font-size: .95rem; padding: var(--s4); text-align: center; }
  .kp-badge { position: absolute; top: var(--s2); left: var(--s2); display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 4px; background: rgba(0, 0, 0, .65); color: #fff; font-size: .75rem; font-weight: 700; letter-spacing: .04em; }
  .kp-dot { width: 8px; height: 8px; border-radius: 50%; background: #999; }
  .is-live .kp-dot { background: #ff4d4d; animation: kp-pulse 1.4s infinite; }
  @keyframes kp-pulse { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .is-live .kp-dot { animation: none; } }
  .kp-ts { position: absolute; right: var(--s2); bottom: var(--s2); padding: 3px 8px; border-radius: 4px; background: rgba(0, 0, 0, .65); color: #fff; font: 600 .75rem ui-monospace, monospace; }
  .kp-info { display: grid; padding: var(--s3) var(--s4); }
  .kp-info strong { color: var(--ink); }
  .kp-info span { font-size: .9rem; color: var(--muted); }

  .kp-events { border: 1px solid var(--line); border-radius: var(--radius); padding: var(--s5); }
  .kp-events h2 { font-size: 1.35rem; }
  .kp-events ol { list-style: none; margin: 0 0 var(--s5); padding: 0; }
  .kp-events li { position: relative; display: grid; padding: var(--s3) 0 var(--s3) var(--s5); border-top: 1px solid var(--line); font-size: .95rem; }
  .kp-events li:first-child { border-top: 0; }
  .kp-events li::before { content: ''; position: absolute; left: 0; top: 20px; width: 10px; height: 10px; border-radius: 50%; background: var(--blue); }
  .kp-events li.is-warn::before { background: #d97706; }
  .kp-events li.is-bad::before { background: var(--error); }
  .kp-events strong { color: var(--ink); }
  .kp-events span { font-size: .85rem; color: var(--muted); }
  .kp-help-box { background: var(--blue-50); border-radius: var(--radius); padding: var(--s4); }
  .kp-help-box p { font-size: .95rem; }
  .kp-help-box .btn { width: 100%; }

  /* Visare */
  .kp-viewer { width: min(980px, 94vw); padding: 0; border: 0; border-radius: var(--radius); overflow: hidden; }
  .kp-viewer::backdrop { background: rgba(0, 20, 50, .7); }
  .kp-vh { display: flex; justify-content: space-between; align-items: center; padding: var(--s3) var(--s3) var(--s3) var(--s5); border-bottom: 1px solid var(--line); }
  .kp-vh h2 { font-size: 1.35rem; margin: 0; }
  .kp-close { width: 44px; height: 44px; border: 0; background: none; cursor: pointer; color: var(--ink); display: grid; place-items: center; }
  .kp-close :global(svg) { width: 24px; height: 24px; }
  .kp-ctl { display: flex; flex-wrap: wrap; gap: var(--s2); padding: var(--s4) var(--s5); }
  .kp-ghost { min-height: 44px; padding: 0 var(--s4); border: 1px solid #b9c2cd; border-radius: var(--radius); background: #fff; font: 600 .95rem var(--font-body); color: var(--ink); cursor: pointer; }
  .kp-timeline { position: relative; height: 32px; margin: 0 var(--s5); border-radius: 6px; background: #e9edf3; overflow: hidden; }
  .kp-rec { position: absolute; inset: 0 4% 0 0; background: #a9c9ee; }
  .kp-mv { position: absolute; top: 0; bottom: 0; width: 2%; background: #d97706; }
  .kp-now { position: absolute; top: 0; bottom: 0; left: 96%; width: 3px; background: var(--error); }
  .kp-tl-lab { display: flex; justify-content: space-between; margin: var(--s1) var(--s5) var(--s5); font-size: .8rem; color: var(--muted); }
</style>
