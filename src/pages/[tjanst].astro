---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { TJANST_BILD } from '../lib/bilder';
import { SITE } from '../lib/site';

export async function getStaticPaths() {
  const tjanster = await getCollection('tjanster');
  return tjanster.map((t) => ({ params: { tjanst: t.id }, props: { t } }));
}
const { t } = Astro.props;
const { Content } = await render(t);
const bild = TJANST_BILD[t.id];
const NAMN: Record<string, string> = { bygglarm: 'Bygglarm', stallningslarm: 'Ställningslarm', 'butik-kontor': 'Butik & kontor', kamerabevakning: 'Kamerabevakning', larmvaska: 'Larmväska' };
const namn = NAMN[t.id] ?? t.data.h1;
---
<Base title={t.data.title} description={t.data.description}>
  <section class="thero">
    <div class="wrap">
      <div class="sign">
        <div class="sign__band"><span>Larmuthyrning · {namn}</span><span>Säkerhetsmäklarna sedan {SITE.grundat}</span></div>
        <div class="fields thero__grid">
          <div class="field thero__main">
            <h1>{t.data.h1}</h1>
            <ul class="benefits">
              {t.data.benefits.map((b) => <li><Icon name="check" />{b}</li>)}
            </ul>
          </div>
          <div class="thero__photo">
            <Image src={bild.src} alt={bild.alt} widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 520px" loading="eager" fetchpriority="high" />
          </div>
          <div class="field field--yellow thero__call">
            <div>
              <span class="field__k">Ring oss</span>
              <a class="thero__tel num" href={SITE.telefonHref}>{SITE.telefon}</a>
            </div>
            <a class="btn btn--ink" href="#offert">Begär offert <Icon name="arrow" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--plate">
    <div class="wrap tbody">
      <article class="prose"><Content /></article>
      <aside class="sign tside" id="offert" aria-labelledby="offert-rubrik">
        <div class="sign__band"><h2 id="offert-rubrik">Begär offert</h2></div>
        <div class="tside__in">
          <p>Fyll i det du vet. Vi ringer upp, oftast samma dag.</p>
          <QuoteForm />
        </div>
      </aside>
    </div>
  </section>

  {t.data.faq.length > 0 && (
    <section class="section">
      <div class="wrap"><Faq items={t.data.faq} /></div>
    </section>
  )}

  <section class="section section--plate">
    <div class="wrap">
      <h2>Andra larmlösningar</h2>
      <ServiceCards exclude={t.id} />
    </div>
  </section>
</Base>

<style>
  .thero { padding: var(--s6) 0 var(--s7); }
  .thero__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  .thero__main { padding: var(--s6); }
  .thero h1 { font-size: clamp(2.3rem, 5vw, 4.4rem); margin-bottom: var(--s5); }
  .benefits { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s3); }
  .benefits li { display: flex; gap: var(--s3); align-items: flex-start; font-weight: 600; color: var(--ink); }
  .benefits :global(svg) { width: 22px; height: 22px; color: var(--ink); background: var(--yellow); padding: 3px; flex: none; margin-top: 1px; }
  .thero__photo { position: relative; min-height: 300px; }
  .thero__photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .thero__call { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: var(--s4) var(--s6); flex-wrap: wrap; padding: var(--s4) var(--s6); }
  .thero__tel { display: block; color: var(--ink); text-decoration: none; font: 800 clamp(2.1rem, 4vw, 3rem)/1 var(--font); font-stretch: 72%; }
  .thero__tel:hover { color: var(--ink); text-decoration: underline; text-decoration-thickness: 3px; }
  @media (max-width: 900px) {
    .thero { padding-top: var(--s4); }
    .thero__grid { grid-template-columns: 1fr; }
    .thero__main { padding: var(--s5) var(--s4); }
    .thero__photo { min-height: 220px; }
    .thero__call { padding: var(--s4); }
    .thero__call .btn { width: 100%; }
  }

  .tbody { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: var(--s8); align-items: start; }
  .tside { position: sticky; top: 100px; box-shadow: none; }
  .tside__in { padding: var(--s5); }
  .tside__in > p { color: var(--text); }
  @media (max-width: 1060px) { .tbody { grid-template-columns: 1fr; gap: var(--s6); } .tside { position: static; } }
  @media (max-width: 640px) { .tside__in { padding: var(--s4); } }
</style>
