---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { TJANST_BILD } from '../lib/bilder';
import { SITE } from '../lib/site';

export async function getStaticPaths() {
  const tjanster = await getCollection('tjanster');
  return tjanster.map((t) => ({ params: { tjanst: t.id }, props: { t } }));
}
const { t } = Astro.props;
const { Content } = await render(t);
const bild = TJANST_BILD[t.id];
---
<Base title={t.data.title} description={t.data.description}>
  <section class="thero blue-field" aria-labelledby="tjanst-rubrik">
    <div class="wrap">
      <div class="thero__copy">
        <h1 id="tjanst-rubrik">{t.data.h1}</h1>
        <ul class="benefits" role="list">
          {t.data.benefits.map((b) => <li><Icon name="check" />{b}</li>)}
        </ul>
        <div class="actions">
          <a class="btn btn--primary" href={SITE.telefonHref}><Icon name="phone" />Ring {SITE.telefon}</a>
          <a class="btn btn--outline" href="#offert">Begär offert</a>
        </div>
      </div>
    </div>
    <div class="thero__media">
      <Image src={bild.src} alt={bild.alt} widths={[600, 900, 1200]} sizes="(max-width: 1100px) 100vw, 61vw" format="webp" priority />
    </div>
  </section>

  <div class="section">
    <div class="wrap tbody">
      <article class="prose"><Content /></article>
      <aside class="form-card tside" id="offert" tabindex="-1" aria-labelledby="offert-rubrik">
        <h2 id="offert-rubrik">Begär offert</h2>
        <p>Fyll i det du vet. Vi ringer upp, oftast samma dag.</p>
        <QuoteForm />
      </aside>
    </div>
  </div>

  {t.data.faq.length > 0 && (
    <div class="section section--soft">
      <div class="wrap"><Faq items={t.data.faq} /></div>
    </div>
  )}

  <section class="section" aria-labelledby="andralarm-rubrik">
    <div class="wrap">
      <h2 id="andralarm-rubrik">Andra larmlösningar</h2>
      <ServiceCards exclude={t.id} />
    </div>
  </section>
</Base>

<style>
  .thero { position: relative; isolation: isolate; container-type: inline-size; }
  .thero__copy { max-width: min(48cqw, calc(64cqw - var(--page-edge) - 188px), 600px); padding-block: clamp(36px, 4.3vw, 72px); }
  .thero h1 { font-size: clamp(3rem, 5vw, 4.625rem); overflow-wrap: anywhere; }
  .benefits { list-style: none; padding: 0; margin: 0 0 26px; display: grid; gap: 8px; }
  .benefits li { display: flex; gap: 10px; align-items: flex-start; }
  .benefits :global(svg) { width: 19px; height: 19px; margin-top: .2em; flex: none; }
  .thero__media { position: absolute; z-index: -1; inset: 0 0 0 39%; container-type: size; }
  .thero__media img {
    width: 100%; height: 100%; object-fit: cover;
    clip-path: polygon(calc(41% - 100cqh * var(--slope)) 0, 100% 0, 100% 100%, 41% 100%);
  }
  .tbody { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 420px); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .tside { position: sticky; top: 84px; }

  @media (max-width: 1100px) {
    .thero__copy { max-width: 640px; padding-block: 34px 24px; }
    .thero__media { position: relative; inset: auto; aspect-ratio: 2; }
    .thero__media img { clip-path: polygon(0 calc(100cqw * var(--slope)), 100% 0, 100% 100%, 0 100%); }
  }
  @media (max-width: 900px) {
    .tbody { grid-template-columns: minmax(0, 1fr); }
    .tside { position: static; }
  }
  @media (max-width: 640px) {
    .thero h1 { font-size: clamp(2.8125rem, 10.6vw, 4.125rem); }
    .thero__media { aspect-ratio: 1.65; }
  }
</style>
