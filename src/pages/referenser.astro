---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import referenser from '../data/referenser.json';
import kunder from '../data/kunder.json';
import { NAV, SITE, url } from '../lib/site';
---
<Base title="Referenser och uppdrag – larmuthyrning | Säkerhetsmäklarna" description="Exempel på uppdrag: bygglarm för hela kvarter, stormarknad larmad samma dag, containerlarm och ställningslarm. Se några av våra kunder.">
  <div class="page-top blue-field">
    <div class="wrap">
      <h1>Referenser</h1>
      <p class="lead">Några exempel på uppdrag där vi har hyrt ut och installerat larm.</p>
    </div>
  </div>
  <div class="section">
    <div class="wrap">
      <ul class="refs" role="list">
        {referenser.map((r) => {
          const href = `/${r.kategori}/`;
          return (
            <li class="ref">
              <h2>{r.titel}</h2>
              <p>{r.text}</p>
              <a class="text-link" href={url(href)}>{NAV.find((item) => item.href === href)?.label ?? r.kategori} <Icon name="arrow" /></a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
  {SITE.visaKunder && kunder.length > 0 && (
    <section class="section section--soft" aria-labelledby="kunder-rubrik">
      <div class="wrap">
        <h2 id="kunder-rubrik">Några av våra kunder</h2>
        <ul class="kunder" role="list">{kunder.map((k) => <li>{k}</li>)}</ul>
      </div>
    </section>
  )}
  <CtaBand />
</Base>

<style>
  .refs, .kunder { list-style: none; margin: 0; padding: 0; }
  .refs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .ref { display: flex; flex-direction: column; padding: clamp(16px, 2.5vw, 28px); border: 1px solid var(--line); border-radius: var(--radius); }
  .ref h2 { font-size: 1.875rem; margin-bottom: 8px; }
  .ref p { flex: 1; }
  .kunder { display: flex; flex-wrap: wrap; gap: 8px 24px; border-top: 1px solid var(--line); padding-top: 16px; font-weight: 700; }
  @media (max-width: 800px) { .refs { grid-template-columns: minmax(0, 1fr); } }
</style>
