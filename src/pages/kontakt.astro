---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../lib/site';
---
<Base title="Kontakt och offert – hyr larm | Säkerhetsmäklarna" description="Ring 08-752 98 00 eller skicka en offertförfrågan. Säkerhetsmäklarna, Strålgatan 11, Stockholm. Larmet är oftast i drift samma dag.">
  <section class="section">
    <div class="wrap kontakt">
      <div>
        <h1>Kontakta oss</h1>
        <p class="lead">Snabbast är att ringa. Då kan vi oftast ha larmet i drift samma dag.</p>
        <div class="field field--yellow kontakt__call">
          <span class="field__k">Ring oss</span>
          <a class="tel num" href={SITE.telefonHref}>{SITE.telefon}</a>
        </div>
        <dl class="info">
          <dt>E-post</dt><dd><a href={`mailto:${SITE.epost}`}>{SITE.epost}</a></dd>
          <dt>Adress</dt><dd>{SITE.juridisktNamn}<br />{SITE.gata}<br />{SITE.postnr} {SITE.ort}</dd>
        </dl>
      </div>
      <div class="sign">
        <div class="sign__band"><h2>Begär offert</h2></div>
        <div class="kontakt__in">
          <p>Fyll i det du vet, så ringer vi upp.</p>
          <QuoteForm />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .kontakt { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--s7); align-items: start; }
  .kontakt__call { margin: var(--s5) 0 var(--s6); }
  .kontakt__call .field__k { color: var(--ink); margin: 0; }
  .tel { display: block; color: var(--ink); text-decoration: none; font: 800 clamp(2.4rem, 5vw, 3.6rem)/1 var(--font); font-stretch: 72%; }
  .tel:hover { color: var(--ink); text-decoration: underline; text-decoration-thickness: 3px; }
  .info { display: grid; grid-template-columns: auto 1fr; gap: var(--s3) var(--s5); margin: 0; padding-top: var(--s5); border-top: 2px solid var(--ink); }
  .info dt { font: 700 .78rem/1.6 var(--font); font-stretch: 85%; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .info dd { margin: 0; }
  .kontakt__in { padding: var(--s5) var(--s6) var(--s6); }
  @media (max-width: 900px) { .kontakt { grid-template-columns: 1fr; gap: var(--s6); } .kontakt__in { padding: var(--s4); } }
</style>
