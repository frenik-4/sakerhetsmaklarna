---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
---
<Base title="Kontakt och offert – hyr larm | Säkerhetsmäklarna" description="Ring 08-752 98 00 eller skicka en offertförfrågan. Säkerhetsmäklarna, Strålgatan 11, Stockholm. Larmet är oftast i drift samma dag.">
  <div class="page-top blue-field">
    <div class="wrap">
      <h1>Kontakta oss</h1>
      <p class="lead">Snabbast är att ringa. Då kan vi oftast ha larmet i drift samma dag.</p>
    </div>
  </div>

  <div class="section">
    <div class="wrap kontakt">
      <div>
        <h2>Ring oss</h2>
        <p>Vardagar och akut.</p>
        <a class="btn btn--primary" href={SITE.telefonHref}><Icon name="phone" />Ring {SITE.telefon}</a>
        <dl class="info">
          <dt>E-post</dt><dd><a href={`mailto:${SITE.epost}`}>{SITE.epost}</a></dd>
          <dt>Adress</dt><dd>{SITE.juridisktNamn}<br />{SITE.gata}<br />{SITE.postnr} {SITE.ort}</dd>
        </dl>
      </div>
      <section class="form-card" aria-labelledby="offert-rubrik">
        <h2 id="offert-rubrik">Begär offert</h2>
        <p>Fyll i det du vet, så ringer vi upp.</p>
        <QuoteForm />
      </section>
    </div>
  </div>
</Base>

<style>
  .kontakt { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(28px, 6vw, 88px); align-items: start; }
  .info { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px 20px; margin: 28px 0 0; padding-top: 20px; border-top: 1px solid var(--line); }
  .info dt { font-weight: 700; }
  .info dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 800px) { .kontakt { grid-template-columns: minmax(0, 1fr); } }
</style>
