---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../lib/site';
---
<Base title="Kontakt och offert – hyr larm | Säkerhetsmäklarna" description="Ring 08-752 98 00 eller skicka en offertförfrågan. Säkerhetsmäklarna, Strålgatan 11, Stockholm. Larmet är oftast i drift samma dag.">
  <section class="section">
    <div class="wrap kontakt">
      <div>
        <h1>Kontakta oss</h1>
        <p class="lead">Snabbast är att ringa. Då kan vi oftast ha larmet i drift samma dag.</p>
        <div class="kontakt__call section--dark">
          <span class="field__k">Ring oss, vardagar och akut</span>
          <a class="tel num" href={SITE.telefonHref}>{SITE.telefon}</a>
        </div>
        <dl class="info">
          <dt>E-post</dt><dd><a href={`mailto:${SITE.epost}`}>{SITE.epost}</a></dd>
          <dt>Adress</dt><dd>{SITE.juridisktNamn}<br />{SITE.gata}<br />{SITE.postnr} {SITE.ort}</dd>
        </dl>
      </div>
      <div class="kontakt__form">
        <h2>Begär offert</h2>
        <p>Fyll i det du vet, så ringer vi upp.</p>
        <QuoteForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .kontakt { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--s8); align-items: start; }
  .kontakt__call { margin: var(--s5) 0 var(--s6); padding: var(--s5) var(--s6); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .kontakt__call .field__k { color: var(--on-navy-muted); margin-bottom: var(--s2); }
  .tel { display: block; color: #fff; text-decoration: none; font: 700 clamp(2.2rem, 4.4vw, 3.2rem)/1.05 var(--font); letter-spacing: -.03em; }
  .tel:hover { color: #fff; text-decoration: underline; text-decoration-thickness: 2px; }
  .info { display: grid; grid-template-columns: auto 1fr; gap: var(--s3) var(--s5); margin: 0; padding-top: var(--s5); border-top: 1px solid var(--rule); }
  .info dt { font: 600 .75rem/1.8 var(--font); text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .info dd { margin: 0; }
  .kontakt__form { background: var(--plate); border: 1px solid var(--rule); border-radius: var(--radius-lg); padding: var(--s6); box-shadow: var(--shadow-lg); }
  .kontakt__form h2 { font-size: 1.6rem; margin-bottom: var(--s1); }
  .kontakt__form > p { color: var(--muted); }
  @media (max-width: 900px) { .kontakt { grid-template-columns: 1fr; gap: var(--s6); } .kontakt__form { padding: var(--s5) var(--s4); } }
</style>
