---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/HomeHero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import start from '../data/start.json';
import faq from '../data/faq.json';
import referenser from '../data/referenser.json';
import kunder from '../data/kunder.json';
import montor from '../assets/img/montor.jpg';
import { NAV, SITE, url } from '../lib/site';
---
<Base
  title="Larmuthyrning i Stockholm – hyrlarm i drift samma dag | Säkerhetsmäklarna"
  description="Hyr larm för bygge, ställning, butik, kontor och evenemang. Vi installerar, kopplar till larmcentral och tar ner igen – oftast i drift samma dag.">

  <HomeHero />

  {SITE.visaKunder && kunder.length > 0 && (
    <section class="kunder" data-reveal aria-labelledby="kunder-rubrik">
      <div class="wrap kunder__in reveal">
        <h2 id="kunder-rubrik">Bland våra kunder</h2>
        <ul>{kunder.map((k) => <li>{k}</li>)}</ul>
      </div>
    </section>
  )}

  <section class="section services-section" data-reveal aria-labelledby="tjanster-rubrik">
    <div class="wrap">
      <h2 class="reveal" id="tjanster-rubrik">Tjänster</h2>
      <ServiceCards />
    </div>
  </section>

  <section class="section section--soft" data-reveal aria-labelledby="steg-rubrik">
    <div class="wrap steps">
      <div class="reveal">
        <h2 id="steg-rubrik">Så går det till</h2>
        <ol class="steps__list" role="list">
          {start.steg.map((s, i) => (
            <li>
              <span class="steps__n" aria-hidden="true">{i + 1}</span>
              <div><h3>{s.titel}</h3><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="steps__picture reveal">
        <Image src={montor} alt="Montör från Säkerhetsmäklarna sätter upp en detektor på en byggställning" widths={[500, 900, 1200]} sizes="(max-width: 800px) 100vw, 600px" format="webp" />
      </div>
    </div>
  </section>

  <section class="section" data-reveal aria-labelledby="usp-rubrik">
    <div class="wrap">
      <h2 id="usp-rubrik" class="reveal">Därför Säkerhetsmäklarna</h2>
      <ul class="columns columns--usp reveal" role="list">
        {start.usps.map((item) => <li><h3>{item.titel}</h3><p>{item.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft" data-reveal aria-labelledby="ref-rubrik">
    <div class="wrap">
      <h2 id="ref-rubrik" class="reveal">Uppdrag vi har gjort</h2>
      <ul class="columns reveal" role="list">
        {referenser.slice(0, 3).map((r) => {
          const href = `/${r.kategori}/`;
          return (
            <li>
              <h3>{r.titel}</h3>
              <p>{r.text}</p>
              <a class="text-link" href={url(href)}>{NAV.find((item) => item.href === href)?.label ?? r.kategori} <Icon name="arrow" /></a>
            </li>
          );
        })}
      </ul>
      <p class="more reveal"><a href={url('/referenser/')} class="text-link">Fler uppdrag <Icon name="arrow" /></a></p>
    </div>
  </section>

  <div class="section" data-reveal>
    <div class="wrap">
      <div class="reveal"><Faq items={faq} limit={5} /></div>
      <p class="more reveal"><a href={url('/fragor-och-svar/')} class="text-link">Alla frågor och svar <Icon name="arrow" /></a></p>
    </div>
  </div>

  <CtaBand />
</Base>

<style>
  .kunder { border-block: 1px solid var(--line); padding-block: 18px; }
  .kunder__in { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; }
  .kunder h2 { margin: 0; font-size: 1.5rem; }
  .kunder ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; color: var(--muted); font-weight: 500; }
  .services-section { padding-top: clamp(30px, 5vw, 54px); }
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(24px, 5vw, 72px); }
  .steps__list { list-style: none; padding: 0; margin: 0; }
  .steps__list li { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 14px; padding-block: 16px; border-bottom: 1px solid var(--line); }
  .steps__list li:first-child { border-top: 1px solid var(--line); }
  .steps__list h3 { margin-bottom: 6px; }
  .steps__list p { margin: 0; }
  .steps__n {
    display: grid; place-items: center; align-self: start; min-height: 42px;
    background: var(--blue); color: var(--white); font: 600 1.625rem/1 var(--font-heading);
  }
  .steps__picture img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .columns { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .columns li { display: flex; flex-direction: column; padding: 20px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .columns p { flex: 1; }
  .columns--usp { gap: 0; border-block: 1px solid var(--line); }
  .columns--usp li { border: 0; padding-inline: 20px; }
  .columns--usp li + li { border-left: 1px solid var(--line); }
  .columns--usp li:first-child { padding-left: 0; }
  .columns--usp p, .more { margin-bottom: 0; }
  .more { margin-top: 24px; }

  @media (max-width: 800px) {
    .steps, .columns { grid-template-columns: minmax(0, 1fr); }
    .columns--usp li { padding-inline: 0; }
    .columns--usp li + li { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
