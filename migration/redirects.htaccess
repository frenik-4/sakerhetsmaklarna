# Redirects från gamla sajten till nya URL:er
# Apache mod_rewrite-regler (301). Gäller både /?page_id=NN och /index.php?page_id=NN.
# Avslutande ? i målet tar bort query stringen.

RewriteEngine On

# 2 startsida -> /
RewriteCond %{QUERY_STRING} ^page_id=2$
RewriteRule ^(index\.php)?$ /? [R=301,L]

# 270 tack-for-ditt-intresse-2 -> /kontakt/
RewriteCond %{QUERY_STRING} ^page_id=270$
RewriteRule ^(index\.php)?$ /kontakt/? [R=301,L]

# 4 tack-for-ditt-intresse -> /kontakt/
RewriteCond %{QUERY_STRING} ^page_id=4$
RewriteRule ^(index\.php)?$ /kontakt/? [R=301,L]

